-- ──────────────────────────────────────────────
-- LOGIC
-- ──────────────────────────────────────────────
local wBtns = {}
local choiceHist = {}

local function clearBrowse()
    for _,b in ipairs(wBtns) do if b and b.Parent then b:Destroy() end end
    wBtns = {}
end

local function addWordBtn(word, lo)
    local row = Instance.new("Frame"); row.Size=UDim2.new(1,0,0,40); row.BackgroundTransparency=1; row.LayoutOrder=lo; row.Parent=BA
    local btn = RoundBtn(row, UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), CLR.card, word, CLR.bodyText, 13)
    btn.TextXAlignment=Enum.TextXAlignment.Left
    local pad=Instance.new("UIPadding"); pad.PaddingLeft=UDim.new(0,10); pad.Parent=btn
    local badge=RoundBtn(btn, UDim2.new(0,50,0,26), UDim2.new(1,-56,0.5,-13), CLR.accentDark, "Copy", CLR.accent, 11)
    btn.MouseEnter:Connect(function() tween(btn,{BackgroundColor3=CLR.cardHover},0.12) end)
    btn.MouseLeave:Connect(function() tween(btn,{BackgroundColor3=CLR.card},0.12) end)
    local function use()
        if setclipboard then setclipboard(word) end
        badge.Text="✓"; tween(badge,{BackgroundColor3=CLR.badgeGreen},0.1)
        task.delay(1.2,function() if badge and badge.Parent then badge.Text="Copy"; tween(badge,{BackgroundColor3=CLR.accentDark},0.2) end end)
        usedWords[word]=true; SLbl.Text="Copied: "..word
    end
    btn.MouseButton1Click:Connect(use); badge.MouseButton1Click:Connect(use)
    table.insert(wBtns, row)
end

local function populateBrowse(letter)
    clearBrowse()
    local fresh = getFresh(letter)
    local sample = pickRandom(fresh, 30)
    CntLbl.Text = #(DB[letter] or {}).."w"
    for i,w in ipairs(sample) do addWordBtn(w,i) end
    SLbl.Text = #sample.." words for '"..letter.."' · tap to copy"
end

local function drawVersus(letter)
    local fresh = getFresh(letter)
    if #fresh < 2 then usedWords={}; fresh=getFresh(letter) end
    local pair = pickRandom(fresh, 2)
    pickA = pair[1] or "—"; pickB = pair[2] or "—"
    LblAW.Text=pickA; LblBW.Text=pickB
    SLbl.Text = "Pick A or B for '"..letter.."'"
end

local function addHist(word, side)
    local color = side=="A" and CLR.accent or CLR.rival
    local h=Lbl(HS, UDim2.new(1,-4,0,20), UDim2.new(0,2,0,0), side..": "..word, color, 11, Enum.TextXAlignment.Left)
    h.LayoutOrder=#choiceHist; table.insert(choiceHist,h)
    task.defer(function() HS.CanvasPosition=Vector2.new(0,HL.AbsoluteContentSize.Y) end)
end

-- tab switching
local function setMode(m)
    mode=m
    if m=="browse" then
        BA.Visible=true; VA.Visible=false
        tween(tabB,{BackgroundColor3=CLR.accent,TextColor3=CLR.bg},0.15)
        tween(tabV,{BackgroundColor3=CLR.card,TextColor3=CLR.bodyText},0.15)
    else
        BA.Visible=false; VA.Visible=true
        tween(tabV,{BackgroundColor3=CLR.rival,TextColor3=CLR.bg},0.15)
        tween(tabB,{BackgroundColor3=CLR.card,TextColor3=CLR.bodyText},0.15)
        if currentLetter then drawVersus(currentLetter) end
    end
end

tabB.MouseButton1Click:Connect(function() setMode("browse") end)
tabV.MouseButton1Click:Connect(function() setMode("versus") end)

GoBtn.MouseButton1Click:Connect(function()
    local raw = string.sub(LetBox.Text or "",1,1)
    if raw=="" then SLbl.Text="⚠ Type a letter first"; return end
    local letter = string.upper(raw)
    if not DB[letter] then SLbl.Text="⚠ No list for '"..letter.."'"; return end
    currentLetter=letter; usedWords={}
    if mode=="browse" then populateBrowse(letter) else drawVersus(letter) end
end)

LetBox.FocusLost:Connect(function(enter)
    if enter then GoBtn.MouseButton1Click:Fire() end
end)

PABtn.MouseButton1Click:Connect(function()
    if not pickA or pickA=="—" then return end
    if setclipboard then setclipboard(pickA) end
    usedWords[pickA]=true; addHist(pickA,"A"); SLbl.Text="Copied A: "..pickA
    tween(CA,{BackgroundColor3=CLR.accentDark},0.15)
    task.delay(0.3,function() tween(CA,{BackgroundColor3=CLR.card},0.25); if currentLetter then drawVersus(currentLetter) end end)
end)

PBBtn.MouseButton1Click:Connect(function()
    if not pickB or pickB=="—" then return end
    if setclipboard then setclipboard(pickB) end
    usedWords[pickB]=true; addHist(pickB,"B"); SLbl.Text="Copied B: "..pickB
    tween(CB,{BackgroundColor3=CLR.rivalDark},0.15)
    task.delay(0.3,function() tween(CB,{BackgroundColor3=CLR.card},0.25); if currentLetter then drawVersus(currentLetter) end end)
end)

NBtn.MouseButton1Click:Connect(function()
    if currentLetter then drawVersus(currentLetter) end
end)

