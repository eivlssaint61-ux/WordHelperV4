local function RoundFrame(parent, size, pos, color, radius)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.BackgroundColor3, f.BorderSizePixel = size, pos, color, 0
    f.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, radius or 10); c.Parent = f
    return f
end

local function RoundBtn(parent, size, pos, bg, txt, tc, ts)
    local b = Instance.new("TextButton")
    b.Size, b.Position, b.BackgroundColor3, b.BorderSizePixel = size, pos, bg, 0
    b.Text, b.TextColor3, b.Font, b.TextSize = txt, tc or CLR.white, Enum.Font.GothamBold, ts or 14
    b.AutoButtonColor = false
    b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,8); c.Parent = b
    return b
end

local function Lbl(parent, size, pos, text, color, ts, align, bold)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.Text = size, pos, text
    l.TextColor3, l.BackgroundTransparency, l.BorderSizePixel = color or CLR.bodyText, 1, 0
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextSize = ts or 14
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextWrapped, l.Parent = true, parent
    return l
end

