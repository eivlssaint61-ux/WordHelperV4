    collapsed = not collapsed
    if collapsed then
        for _, f in ipairs(contentFrames) do f.Visible = false end
        VA.Visible = false
        tween(Main, {Size = UDim2.new(0, PW, 0, TH)}, 0.18)
        MinBtn.Text = "+"
    else
        tween(Main, {Size = UDim2.new(0, PW, 0, PH)}, 0.18)
        task.delay(0.14, function()
            for _, f in ipairs(contentFrames) do f.Visible = true end
            if mode=="browse" then BA.Visible=true; VA.Visible=false
            else BA.Visible=false; VA.Visible=true end
        end)
        MinBtn.Text = "–"
    end
end)

