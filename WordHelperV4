local function tween(obj, props, t, style, dir)
    local ti = TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    TweenService:Create(obj, ti, props):Play()
end

local function getFresh(letter)
    local all = DB[letter] or {}
    local fresh = {}
    for _, w in ipairs(all) do
        if not usedWords[w] then table.insert(fresh, w) end
    end
    if #fresh < 6 then
        usedWords = {}
        return all
    end
    return fresh
end

local function pickRandom(pool, count)
    local copy = {}
    for _, v in ipairs(pool) do table.insert(copy, v) end
    local result = {}
    for i = 1, math.min(count, #copy) do
        local idx = math.random(1, #copy)
        table.insert(result, copy[idx])
        table.remove(copy, idx)
    end
    return result
end

